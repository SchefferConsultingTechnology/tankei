{
  "name": "tankei",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @tankei/shared build && pnpm --filter @tankei/api db:generate",
    "db:migrate": "pnpm --filter @tankei/api db:migrate"
  },
  "devDependencies": {
    "turbo": "^2.5.8",
    "typescript": "~5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@parcel/watcher", "esbuild", "unrs-resolver"]
  }
}
