{
  "expo": {
    "name": "Tankei",
    "slug": "tankei",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.tankei.app"
    },
    "android": {
      "package": "br.com.tankei.app",
      "versionCode": 7,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyC-hpnuntdXqK-fAk5nE9t3FLcCqdz-0Fg"
        }
      },
      "adaptiveIcon": {
        "backgroundColor": "#012049",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Tankei usa sua localização para mostrar os postos mais próximos de você."
        }
      ],
      [
        "react-native-nitro-google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.881187129858-3elfcgukc2u988u5gc5sqfvjqv0hd334"
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# O Room acha o banco gerado pelo nome (WorkDatabase_Impl, do WorkManager): o R8 não pode renomear nem remover.\n-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class **_Impl { <init>(); }"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#F5F7FB",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#07122A"
          }
        }
      ]
    ],
    "scheme": "tankei",
    "extra": {
      "googleWebClientId": "881187129858-3elfcgukc2u988u5gc5sqfvjqv0hd334.apps.googleusercontent.com"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
