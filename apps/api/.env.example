PORT=3333
DATABASE_URL=postgresql://tankei:tankei@localhost:5433/tankei
# Limite de requisições por IP (padrão: 120 por minuto)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
# Agendamento da importação das referências de preço da ANP (padrão: todo dia às 9h)
ANP_REFERENCE_CRON=0 9 * * *
# Sessão (ADR 0007). Em produção, use um segredo aleatório com 32+ caracteres:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-aleatorio-de-32-caracteres-ou-mais
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Identificadores de cliente aceitos no login (separados por vírgula: web, Android, iOS).
# Vazio desativa o provedor.
# Cliente Web do Google Cloud (ADR 0015).
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
# Recálculo diário do IQP (padrão: todo dia às 3h30)
IQP_RECALC_CRON=30 3 * * *
# Atrás de proxy (Render, ADR 0016): número de proxies confiáveis. Vazio localmente.
TRUST_PROXY=
# E-mails (ADR 0025). Sem RESEND_API_KEY nada é enviado: só registrado no log.
RESEND_API_KEY=
MAIL_FROM=Tankei <nao-responda@scheffer.solutions>
# Opcional: endereço que recebe as respostas aos e-mails.
MAIL_REPLY_TO=
# Links nos e-mails.
PORTAL_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
# WhatsApp Business da equipe (ADR 0031), com DDI e DDD. Vazio esconde o botão.
SUPPORT_WHATSAPP=5548999040445
# Imagens (ADR 0026): armazenamento compatível com S3. Local: SeaweedFS do
# docker compose (pnpm storage:up). Produção: Supabase Storage (S3), balde público.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=tankei
STORAGE_SECRET_ACCESS_KEY=tankei-local
STORAGE_BUCKET=tankei-imagens
STORAGE_PUBLIC_URL=http://localhost:9000/tankei-imagens
# Só local: cria o balde público na subida.
STORAGE_CREATE_BUCKET=true
